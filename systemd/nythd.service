[Unit]
Description=NewNyths Roccat Nyth event daemon
Documentation=https://github.com/LunaBaloona/NewNyth
After=graphical-session.target
Requires=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/nythd --foreground
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
