# Rules for Roccat Nyth mouse.
# These rules have to be applied after 50-udev-default.rules for mode changes not to be overridden.
# If group roccat does not exist, the group root is used.
#
# Install: sudo cp 90-roccat-nyth.rules /etc/udev/rules.d/
# Reload:  sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="input", KERNEL=="event[0-9]*", ACTION=="add", ATTRS{idVendor}=="1e7d", ATTRS{idProduct}=="2e7c|2e7d", GROUP="roccat", MODE="0660"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ACTION=="add", ATTRS{idVendor}=="1e7d", ATTRS{idProduct}=="2e7c|2e7d", GROUP="roccat", MODE="0660"
